│
├── models/
│   ├── best_model_arch1.pth
│   └── model_b8_c128_int.xmodel
│
├── testing_code/
│   ├── model_builder.py
│   └── test.py
│
├── testing_images/
│   ├── clean/
│   └── degraded/
│
├── results/
├── output/
│
├── docs/
│   ├── SOFTWARE_SETUP.md
│   └── final_anas_adeeb_12(2).pdf
│
├── Dockerfile
